<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>4-Player Cam Rep Counter</title>
    <!-- Load TensorFlow.js dan MoveNet MultiPose -->
    <script src="https://jsdelivr.net"></script>
    <script src="https://jsdelivr.net"></script>
    <script src="https://jsdelivr.net"></script>
    <script src="https://jsdelivr.net"></script>

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 10px;
            display: flex;
            justify-content: center;
        }
        .app-container {
            width: 100%;
            max-width: 800px;
            text-align: center;
        }
        .video-container {
            position: relative;
            width: 100%;
            max-width: 480px;
            margin: 0 auto 15px auto;
            background: #000;
            border-radius: 8px;
            overflow: hidden;
        }
        #webcam { display: none; }
        #output-canvas {
            width: 100%;
            display: block;
            transform: scaleX(-1);
        }
        .scoreboard {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-bottom: 15px;
        }
        .player-card {
            background: #1e1e1e;
            padding: 10px;
            border-radius: 8px;
            border: 2px solid #333;
        }
        .player-card h3 { margin: 0 0 5px 0; font-size: 1rem; color: #00adb5; }
        .counter { font-size: 1.8rem; font-weight: bold; color: #eee; }
        .status { font-size: 0.8rem; color: #888; }
        #p1 { border-color: #ff5722; }
        #p2 { border-color: #2196f3; }
        #p3 { border-color: #4caf50; }
        #p4 { border-color: #ffeb3b; }
        .controls button {
            padding: 10px 15px;
            font-size: 0.9rem;
            margin: 0 5px;
            cursor: pointer;
            background-color: #00adb5;
            color: white;
            border: none;
            border-radius: 5px;
        }
        .controls button:hover { background-color: #008c95; }
    </style>
</head>
<body>

    <div class="app-container">
        <div class="video-container">
            <video id="webcam" autoplay playsinline muted></video>
            <canvas id="output-canvas"></canvas>
        </div>

        <div class="scoreboard">
            <div class="player-card" id="p1"><h3>P1</h3><div class="counter">0</div><div class="status">-</div></div>
            <div class="player-card" id="p2"><h3>P2</h3><div class="counter">0</div><div class="status">-</div></div>
            <div class="player-card" id="p3"><h3>P3</h3><div class="counter">0</div><div class="status">-</div></div>
            <div class="player-card" id="p4"><h3>P4</h3><div class="counter">0</div><div class="status">-</div></div>
        </div>

        <div class="controls">
            <button id="start-btn">Mulai Kamera</button>
            <button id="reset-btn">Reset</button>
        </div>
    </div>

    <script>
        const video = document.getElementById('webcam');
        const canvas = document.getElementById('output-canvas');
        const ctx = canvas.getContext('2d');
        let detector;
        let playerStates = [{reps:0,stage:"up"},{reps:0,stage:"up"},{reps:0,stage:"up"},{reps:0,stage:"up"}];

        async function setupCamera() {
            const stream = await navigator.mediaDevices.getUserMedia({ video: { width: 640, height: 480 }, audio: false });
            video.srcObject = stream;
            return new Promise((resolve) => { video.onloadedmetadata = () => resolve(video); });
        }

        async function loadModel() {
            detector = await poseDetection.createDetector(poseDetection.SupportedModels.MoveNet, { modelType: poseDetection.movenet.modelType.MULTIPOSE_LIGHTNING });
        }

        function calculateAngle(p1, p2, p3) {
            let radians = Math.atan2(p3.y - p2.y, p3.x - p2.x) - Math.atan2(p1.y - p2.y, p1.x - p2.x);
            let angle = Math.abs((radians * 180.0) / Math.PI);
            if (angle > 180.0) angle = 360 - angle;
            return angle;
        }

        function checkReps(poses) {
            let sortedPoses = poses.filter(p => p.score > 0.3).sort((a, b) => a.keypoints[0].x - b.keypoints[0].x);
            sortedPoses.forEach((pose, index) => {
                if (index >= 4) return;
                const kp = pose.keypoints;
                const hip = kp[11], knee = kp[13], ankle = kp[15];
                if (hip.score > 0.5 && knee.score > 0.5 && ankle.score > 0.5) {
                    const angle = calculateAngle(hip, knee, ankle);
                    if (angle < 140) {
                        playerStates[index].stage = "down";
                        document.querySelector(`#p${index+1} .status`).innerText = "Turun";
                    }
                    if (angle > 160 && playerStates[index].stage === "down") {
                        playerStates[index].stage = "up";
                        playerStates[index].reps++;
                        document.querySelector(`#p${index+1} .counter`).innerText = playerStates[index].reps;
                        document.querySelector(`#p${index+1} .status`).innerText = "Naik!";
                    }
                }
            });
        }

        async function renderPrediction() {
            const poses = await detector.estimatePoses(video);
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            if (poses && poses.length > 0) {
                checkReps(poses);
                drawKeypoints(poses);
            }
            requestAnimationFrame(renderPrediction);
        }

        function drawKeypoints(poses) {
            const colors = ['#ff5722', '#2196f3', '#4caf50', '#ffeb3b'];
            let sortedPoses = poses.sort((a, b) => a.keypoints[0].x - b.keypoints[0].x);
            sortedPoses.forEach((pose, index) => {
                if (index >= 4) return;
                pose.keypoints.forEach(kp => {
                    if (kp.score > 0.3) {
                        ctx.beginPath(); ctx.arc(kp.x, kp.y, 4, 0, 2 * Math.PI);
                        ctx.fillStyle = colors[index]; ctx.fill();
                    }
                });
            });
        }

        document.getElementById('start-btn').addEventListener('click', async () => {
            document.getElementById('start-btn').innerText = "Memuat AI...";
            try {
                await setupCamera();
                canvas.width = video.videoWidth;
                canvas.height = video.videoHeight;
                await loadModel();
                document.getElementById('start-btn').style.display = 'none';
                renderPrediction();
            } catch (err) {
                alert("Gagal mengakses kamera. Pastikan izin kamera diberikan.");
                document.getElementById('start-btn').innerText = "Mulai Kamera";
            }
        });

        document.getElementById('reset-btn').addEventListener('click', () => {
            playerStates.forEach((p, i) => {
                p.reps = 0; p.stage = "up";
                document.querySelector(`#p${i+1} .counter`).innerText = 0;
                document.querySelector(`#p${i+1} .status`).innerText = "-";
            });
        });
    </script>
</body>
</html>
